# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://theme:theme@localhost:55432/theme_engine
REDIS_URL=redis://localhost:6379

# ── LLM Provider — all optional; unset = deterministic dry-run generation,
# keyword-only scoring, no LLM calls. Set LLM_API_KEY to unlock real
# content generation, format suggestion, and semantic (embedding) scoring.
# LLM_PROVIDER: openai | groq | openrouter | custom
#   groq       → free tier, fast (Llama 3.3 70B)
#   openrouter → free models available (Llama 3.3 70B)
#   openai     → requires paid API key
#   custom     → set LLM_BASE_URL to any OpenAI-compatible endpoint
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=  (auto-set based on provider, override for custom)

# Legacy OpenAI fallback (used if LLM_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Pipeline behavior ──────────────────────────────────────────────────
APPROVAL_REQUIRED=true
POSTING_DRY_RUN=true
DEFAULT_TIME_SLOTS=12:00,17:00,21:00
MIN_POST_GAP_HOURS=3
MAX_POSTS_PER_PAGE_PER_DAY=3

# ── Optional ingestion source credentials — YouTube Trends and Exploding
# Topics are skipped entirely without their key; Product Hunt works keyless
# too, just at lower rate limits (see Settings → Sources for live status). ─
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=theme-page-content-engine/0.1
TWITTER_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=               # Data API v3 key — enables YouTube Trends ingestion source
EXPLODING_TOPICS_API_KEY=      # Exploding Topics Pro API key — enables Exploding Topics ingestion source
PRODUCT_HUNT_TOKEN=            # Product Hunt developer token — optional, raises rate limits on Product Hunt ingestion

# ── Canva (optional — brand asset export) ─────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_REDIRECT_URI=http://localhost:4000/auth/canva/callback

# ── Media Pipeline (TTS, Stock Footage, Video Rendering) ──────────────
# TTS Voice: Edge TTS voice name (free, no API key needed)
# Full list: run `npm run tts:voices` or see https://learn.microsoft.com/en-us/azure/ai-services/speech-service/language-support
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+5%                   # Speech rate: -50% to +100% (slightly faster for Reels)

# Pexels: free stock footage API (get key at https://www.pexels.com/api/)
PEXELS_API_KEY=

# Background music: 'random' (picks from data/bgm/) or 'none'
BGM_MODE=random
BGM_VOLUME=0.15                # 0.0 to 1.0 (relative to voice volume)

# ── Self-host / deployment (Sprint U1) ────────────────────────────────
API_TOKEN=                     # optional bearer token — unset = API is open (local dev default); see SECURITY.md before exposing publicly
MIGRATIONS_DIR=                # override the migrations directory; set automatically inside the Docker image, leave blank for npm run dev / db:init
WEB_DIST=                      # override the built SPA directory served in production; leave blank to use the default (dist-web next to dist)
TPCE_ROLE=                     # api | worker — selects which process scripts/docker-entrypoint.sh starts; leave blank outside Docker
TPCE_MODE=                     # server (default; Docker/npm run dev, BullMQ+Redis) or desktop (single process, embedded Postgres, no Redis — set automatically by `npm run desktop`)
TPCE_DATA_DIR=                 # desktop mode only: embedded Postgres cluster dir; defaults to your OS app-data folder (e.g. ~/Library/Application Support/TPCE)

# ── Legacy / optional integrations (referenced by older generation paths; all optional) ──
# Google AI Studio key — also used for Gemini embeddings if present as an llm config
GOOGLE_AI_API_KEY=
# Image/video generation providers (BYOK; the default workflow uses the manual web bridge instead)
FAL_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
RUNWAY_API_KEY=
HEYGEN_API_KEY=
IMAGE_PROVIDER_PRIORITY=
IMAGE_MODEL_PREFS=
# YouTube upload (live publishing; dry-run works without)
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
