{
  "name": "theme-page-content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-bootstrap.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:services-only": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/api/server.js",
    "worker": "node dist/src/worker/index.js",
    "db:init": "tsx scripts/init-db.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@bull-board/api": "^6.12.0",
    "@bull-board/express": "^6.12.0",
    "@remotion/bundler": "^4.0.458",
    "@remotion/player": "^4.0.458",
    "@remotion/renderer": "^4.0.458",
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "^5.63.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-trends-api": "^4.9.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "lucide-react": "^0.552.0",
    "openai": "^6.8.1",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.458",
    "rss-parser": "^3.13.0",
    "tsx": "^4.20.6",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.6"
  }
}
