# Line endings matter for the launchers.
#
# Shell scripts MUST stay LF: a CRLF `#!/bin/sh` line fails with
# "bad interpreter: No such file or directory". This can happen to anyone who
# clones on Windows with core.autocrlf=true (the default there) and then runs
# the repo under WSL or copies it to a Mac.
#
# The .bat MUST stay CRLF — cmd.exe is unreliable with LF-only batch files.

* text=auto

*.sh    text eol=lf
*.mjs   text eol=lf
*.command text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf
